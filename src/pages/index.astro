---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-2xl w-full px-6 py-24">
      <img src={`${import.meta.env.BASE_URL}logo.png`} alt="" width="56" height="56" class="rounded-xl" />
      <h1
        class="mt-4 text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {config.description}
      </p>

      <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <a
          href="/welcome"
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Welcome</div>
          <div class="mt-0.5 text-sm text-muted-foreground">What Bookhoard is</div>
        </a>
        <a
          href="/getting-started"
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Deploy with Docker</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Start here</div>
        </a>
        <a
          href="https://github.com/bookhoard/bookhoarder"
          target="_blank"
          rel="noopener"
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">GitHub</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Source + issues</div>
        </a>
      </div>
    </main>
  </div>
</BaseLayout>
